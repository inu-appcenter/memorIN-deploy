# memorIN-backend/.env.example을 바탕으로 운영 배포(GHCR 이미지 + Caddy 리버스 프록시)에 맞게 고친 파일이다.
# 이 저장소는 public이므로 실제 .env는 절대 커밋하지 않는다.
#
# 사용법: cp .env.example .env 후 (필수) 표시가 붙은 값을 모두 채운다(README의 ".env 필수값" 표 참고).
#
# SWAGGER_ENABLED, STORAGE_MEDIA_GC_*, SIGNUP_ENABLED는 넣지 않았다. compose.yaml이 이 값들을 backend에
# 넘기지 않으므로 .env에 적어도 반영되지 않고, backend 기본값(Swagger 꺼짐, 미디어 정리 배치 켜짐,
# SIGNUP_ENABLED=true)으로 동작한다. SIGNUP_ENABLED는 /api/health 응답의 signupEnabled 값에만 쓰인다.
# 바꾸려면 compose.yaml의 backend environment에도 해당 줄을 추가해야 한다.

# --- 이미지 태그 ---
# 평소에는 latest를 쓴다. 롤백할 때는 GHCR의 sha-<40자 커밋 해시> 태그로 바꾸고
# docker compose up -d backend 또는 docker compose up -d frontend를 다시 실행한다.
# 7자 짧은 해시로는 이미지를 받지 못한다.
# backend를 되돌릴 때는 그 사이 릴리스에 DB 마이그레이션이 있었는지 먼저 확인한다.
# 이미지를 되돌려도 이미 적용된 스키마 변경은 DB에 그대로 남는다.
BACKEND_TAG=latest
FRONTEND_TAG=latest

# --- 리버스 프록시(Caddy) 연결 포트 ---
# (필수) frontend와 MinIO가 127.0.0.1에 여는 포트다. 같은 서버의 공용 Caddy가 이 포트로 리버스 프록시한다
# (README의 '리버스 프록시(Caddy) 설정' 참고). 서버에서 이미 쓰이는 포트와 겹치지 않는 값을 고른다.
# `/etc/caddy/Caddyfile`을 먼저 확인해 다른 프로젝트가 쓰는 포트를 피한다.
FRONTEND_PORT=
MINIO_S3_PORT=

# --- PostgreSQL ---
POSTGRES_DB=memorin_db
POSTGRES_USER=memorin_user
# (필수) 기본값이 없다. 비워 두면 docker compose up과 pull이 에러를 내고 멈춘다. 예: openssl rand -base64 24
POSTGRES_PASSWORD=
# 127.0.0.1에만 바인딩된다. 원격에서 접속하려면 SSH 터널을 쓴다.
# 앱센터 공용 서버에서는 5432를 다른 서비스가 이미 쓰고 있어 그대로 두면 postgres가 뜨지 않는다.
# 비어 있는 다른 포트로 바꾼다(README의 '리버스 프록시(Caddy) 설정과 DNS 등록' 1번 참고).
POSTGRES_PORT=5432
# postgres 컨테이너의 메모리 상한이다. 측정 없이 정한 출발값이라 DB가 커지면 측정해서 다시 정한다.
# 바꿀 때는 infra/postgres/postgresql.conf의 shared_buffers(256MB) 같은 메모리 설정도 함께 맞춘다.
# 커넥션 수와 max_connections의 관계는 memorIN-backend/docs/hikari-pool-load-test.md를 참고한다.
POSTGRES_MEMORY_LIMIT=512m

# --- MinIO ---
# (필수) MINIO_ROOT_USER와 MINIO_ROOT_PASSWORD는 기본값이 없다. 비워 두면 docker compose up과 pull이 에러를 내고 멈춘다.
# 스토리지가 공개 도메인으로 노출되므로 minioadmin 같은 널리 알려진 값은 쓰지 않는다.
# MinIO는 사용자 3자 이상, 비밀번호 8자 이상을 요구한다.
# 사용자는 영숫자로만 만든다. 예: openssl rand -hex 12
# 비밀번호 예: openssl rand -base64 24
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# MinIO 관리 콘솔 포트다. 관리자만 쓰므로 postgres와 마찬가지로 127.0.0.1에만 바인딩된다.
MINIO_CONSOLE_PORT=9001
MINIO_MEMORY_LIMIT=512m
MINIO_BUCKET_NAME=memorin-media
MINIO_REGION=us-east-1
# (필수) 브라우저와 앱이 presigned URL로 직접 접근할 스토리지 주소다. 비어 있으면 backend가 기동하지 않는다.
# 예: https://memorin-storage.inuappcenter.kr
# Caddy가 이 전용 호스트네임을 127.0.0.1:${MINIO_S3_PORT}로 리버스 프록시해야 한다. presigned URL은
# 경로까지 서명하므로 /storage 같은 하위 경로로는 동작하지 않는다(README 참고).
MINIO_PUBLIC_ENDPOINT=
# presigned URL 유효 시간(초)
MINIO_PRESIGNED_UPLOAD_EXPIRY_SECONDS=600
MINIO_PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=300
# 업로드를 허용할 MIME 타입. 여러 개면 콤마로 구분한다.
MINIO_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime
# 파일 하나의 최대 업로드 크기(바이트)다. 기본값은 50MB다.
# Cloudflare 무료 플랜과 Pro 플랜은 요청 본문을 100MB까지만 받는다. 이 값을 늘리려면 먼저 플랜 한도를 확인한다.
MINIO_MAX_UPLOAD_SIZE_BYTES=52428800

# --- Spring Boot (backend) ---
# backend 컨테이너의 메모리 상한이다. JVM 힙은 이 값의 75%로 잡힌다(compose.yaml의 JAVA_TOOL_OPTIONS).
# backend 포트는 frontend를 거쳐서만 나가므로(위 FRONTEND_PORT) 호스트에 따로 열지 않는다.
BACKEND_MEMORY_LIMIT=1g

# --- 스토리지 할당량 ---
# 사용자 1명당 총 스토리지 할당량(바이트)이다. 기본값은 1GB다.
STORAGE_QUOTA_DEFAULT_LIMIT_BYTES=1073741824
# presigned 업로드 예약(pending_uploads)을 유지하는 시간(초)이다. 커밋되지 않고 만료되면 정리 배치가 회수한다.
STORAGE_QUOTA_PENDING_TTL_SECONDS=900
# 할당량 대비 사용량이 이 비율(%)을 넘으면 경고로 처리한다.
STORAGE_QUOTA_WARNING_THRESHOLD_PERCENT=80

# --- 클라이언트 업로드 전 압축 권장값 (서버는 강제하지 않는다) ---
MEDIA_COMPRESSION_IMAGE_QUALITY_PERCENT=80
MEDIA_COMPRESSION_IMAGE_MAX_WIDTH_PX=1920
MEDIA_COMPRESSION_IMAGE_MAX_HEIGHT_PX=1920

# --- JWT ---
# (필수) 32바이트(256비트) 이상 무작위 문자열을 넣는다. 비어 있거나 짧으면 backend가 기동하지 않는다.
# 예: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRY_MS=900000       # 15분
JWT_REFRESH_EXPIRY_MS=604800000   # 7일

# --- CORS 허용 오리진 ---
# (필수) 웹 공개 주소를 넣는다. 스킴(https)과 호스트까지 정확히 같아야 하고, 여러 개면 콤마로 구분한다.
# 예: https://memorin.inuappcenter.kr
# 비워 두면 기동은 되지만 브라우저가 Origin을 붙이는 요청(로그인 같은 POST, WebSocket)이 403으로 막힌다.
# 값을 빠뜨렸을 때 다른 조직의 도메인이 조용히 적용되는 일을 막으려고 일부러 기본값을 두지 않았다.
CORS_ALLOWED_ORIGINS=

# --- 푸시 알림: FCM (앱 백그라운드) ---
# 끄면(false) 앱으로 가는 푸시(FCM)만 보내지 않는다. 알림 기록은 DB에 남고, 브라우저 푸시는
# WEB_PUSH_ENABLED가 따로 정한다. 앱 없이 웹만 쓴다면 꺼도 된다.
FIREBASE_ENABLED=false
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은 JSON을
# 이 저장소의 secrets/ 폴더에 firebase-service-account.json이라는 이름으로 둔다.
# compose.yaml이 secrets/를 컨테이너의 /run/secrets에 읽기 전용으로 마운트한다.
# 컨테이너는 non-root(spring)로 돌기 때문에 호스트에서 chmod 644 secrets/firebase-service-account.json으로
# 읽기 권한을 준다. true로 켰는데 이 파일이 없거나 읽을 수 없으면 backend가 기동하지 않는다.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# --- 푸시 알림: Web Push (브라우저) ---
# 끄면(false) 브라우저로 가는 푸시만 보내지 않는다. 알림 기록은 DB에 남는다.
# true로 켰는데 아래 VAPID 키가 하나라도 비어 있거나 형식이 잘못되면 backend가 기동하지 않는다.
WEB_PUSH_ENABLED=false
# VAPID 키 쌍이다. npx web-push generate-vapid-keys로 만든다.
# 공개 키는 compose.yaml이 frontend의 VAPID_PUBLIC_KEY로도 넘기므로 여기만 채우면 된다.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# 푸시 서비스 쪽에서 문제가 생겼을 때 연락할 주소다. mailto: 또는 https: 스킴이어야 한다.
# 기본값은 예시 주소이므로 운영에서는 실제로 연락을 받을 수 있는 주소로 바꾼다.
WEB_PUSH_VAPID_SUBJECT=mailto:admin@memorin.local
