# memorIN-backend/.env.example 을 베이스로, 운영 배포(GHCR 이미지 + Cloudflare Tunnel)에
# 필요한 값을 더한 버전이다. 이 저장소는 public이므로 실제 .env는 절대 커밋하지 않는다.
#
# 사용법: cp .env.example .env 후 아래 "필수로 채워야 하는 값"을 전부 채운다.

# ─── 이미지 태그 ────────────────────────────────────────────
# 평소에는 latest. 롤백 시에는 GHCR의 sha-<커밋해시> 태그로 고정해
# `docker compose up -d backend` 또는 `... frontend` 만 다시 실행하면 된다.
BACKEND_TAG=latest
FRONTEND_TAG=latest

# ─── Cloudflare Tunnel (필수) ─────────────────────────────────
# Zero Trust 대시보드 > Networks > Tunnels > Create a tunnel (Cloudflared 커넥터)에서
# 발급한 토큰. 이 토큰 하나로 아웃바운드 연결이 열리고, 도메인 ↔ 컨테이너 매핑(ingress)은
# 같은 대시보드에서 관리한다 — 이 저장소에는 ingress 설정 파일이 없다(README 참고).
CLOUDFLARE_TUNNEL_TOKEN=

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=memorin_db
POSTGRES_USER=memorin_user
POSTGRES_PASSWORD=memorin_pass
# 127.0.0.1에만 바인딩된다 — 원격에서 붙어야 하면 SSH 터널을 쓴다.
POSTGRES_PORT=5432
# 실측 없이 잡은 출발점. DB가 커지면 재실측 필요 — memorIN-backend/docs/hikari-pool-load-test.md 참고.
POSTGRES_MEMORY_LIMIT=512m

# ─── MinIO ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# 관리 콘솔. 관리자 전용이라 postgres처럼 127.0.0.1에만 바인딩된다.
MINIO_CONSOLE_PORT=9001
MINIO_MEMORY_LIMIT=512m
MINIO_BUCKET_NAME=memorin-media
MINIO_REGION=us-east-1
# (필수) 클라이언트(브라우저/앱)가 presigned URL로 직접 접근할 주소.
# storage.<도메인> 을 Cloudflare Tunnel ingress에서 minio:9000 으로 매핑해야 한다.
# MinIO는 경로 리버스 프록시를 지원하지 않으므로 반드시 "전용 호스트네임"이어야 한다
# (예: https://storage.memorin.inuappcenter.co.kr) — /storage 같은 서브패스는 동작하지 않는다.
MINIO_PUBLIC_ENDPOINT=
# presigned URL 유효기간(초)
MINIO_PRESIGNED_UPLOAD_EXPIRY_SECONDS=600
MINIO_PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=300
# 업로드 허용 MIME 타입 (콤마 구분)
MINIO_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif,video/mp4,video/quicktime
# 파일 1개 업로드 최대 크기(byte). 기본 50MB.
# Cloudflare 무료/Pro 플랜의 업로드 본문 상한은 100MB다 — 올릴 계획이면 플랜 상한을 먼저 확인한다.
MINIO_MAX_UPLOAD_SIZE_BYTES=52428800

# ─── Spring Boot (backend) ─────────────────────────────────────
# 컨테이너 네트워크 안에서만 접근하므로 호스트 포트 매핑은 없다. 힙 상한만 조절한다.
BACKEND_MEMORY_LIMIT=1g

# ─── Storage Quota ────────────────────────────────────────────
STORAGE_QUOTA_DEFAULT_LIMIT_BYTES=1073741824
STORAGE_QUOTA_PENDING_TTL_SECONDS=900
STORAGE_QUOTA_WARNING_THRESHOLD_PERCENT=80

# ─── 클라이언트 업로드 전 압축 가이드 파라미터 (서버 강제 아님) ────
MEDIA_COMPRESSION_IMAGE_QUALITY_PERCENT=80
MEDIA_COMPRESSION_IMAGE_MAX_WIDTH_PX=1920
MEDIA_COMPRESSION_IMAGE_MAX_HEIGHT_PX=1920

# ─── JWT (필수) ─────────────────────────────────────────────
# 랜덤 256비트(32바이트) 이상 문자열로 교체. 예: openssl rand -base64 32
JWT_SECRET=
JWT_ACCESS_EXPIRY_MS=900000       # 15분
JWT_REFRESH_EXPIRY_MS=604800000   # 7일

# ─── CORS 허용 오리진 (필수, 콤마 구분) ────────────────────────
# 값을 안 채우면 기동 자체가 실패한다 — 남의 도메인을 조용히 물려받는 사고를 막기 위함이다.
CORS_ALLOWED_ORIGINS=https://memorin.inuappcenter.co.kr

# ─── 푸시 알림: FCM (앱 백그라운드) ────────────────────────────
# 끄면(false) 알림은 DB에 저장만 되고 발송되지 않는다. 앱 없이 웹만 쓴다면 꺼도 된다.
FIREBASE_ENABLED=false
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > "새 비공개 키 생성"으로 받은 JSON을
# 이 저장소의 secrets/ 폴더에 firebase-service-account.json 이름으로 둔다.
# compose.yaml이 secrets/ 를 컨테이너의 /run/secrets 로 읽기 전용 마운트한다.
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json

# ─── 푸시 알림: Web Push (브라우저) ────────────────────────────
# 끄면(false) 알림은 DB에 저장만 되고 발송되지 않는다.
WEB_PUSH_ENABLED=false
# VAPID 키 쌍. npx web-push generate-vapid-keys 로 생성한다.
# 공개 키는 frontend 서비스의 VAPID_PUBLIC_KEY로도 그대로 전달된다(위 compose.yaml 참고) —
# 여기 한 곳만 채우면 되고, 프론트 쪽에 따로 설정할 값은 없다.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 발생 시 연락할 주소. mailto: 또는 https: 스킴이어야 한다.
WEB_PUSH_VAPID_SUBJECT=mailto:admin@memorin.local
